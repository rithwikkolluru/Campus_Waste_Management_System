# Campus Waste Management System - Environment Variables
# Copy this file to .env and fill in your values
# Get Gemini API key FREE at: https://aistudio.google.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collegeDB
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT (make this any long random string)
JWT_SECRET=make_this_any_long_random_string_32chars

# Google OAuth (free at console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Gemini AI (free at aistudio.google.com - no credit card)
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=8000
